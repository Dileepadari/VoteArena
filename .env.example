# Copy to .env and fill in before running in production.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Where the SQLite file lives. Must be on a persistent volume.
DATABASE_PATH=data/votearena.db

# Public origin, used to build the join links and QR codes people scan.
# Get this wrong and every QR on the projector points somewhere unreachable.
PUBLIC_URL=https://vote.example.com

# Signs voter cookies and hashes IP addresses. REQUIRED in production - the app
# refuses to boot without it. Changing it invalidates every existing voter
# identity, which lets people vote a second time, so set it once and keep it.
#   openssl rand -hex 32
SECRET_KEY=

# Number of proxy hops in front of the app. 0 when exposed directly, 1 behind a
# single load balancer or reverse proxy. A number rather than `true` so a client
# cannot spoof its address with a forged X-Forwarded-For header.
TRUST_PROXY=1

# Set to false to stop new sessions being created on a public instance.
ALLOW_SESSION_CREATION=true

# Optional shared password required to create a session. Leave empty for open hosting.
ADMIN_PASSWORD=
